MQTT_HOST=192.168.99.95
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Transport: hid (original USB stick) or serial (FT232 UART).
EATON_TRANSPORT=hid
# Linux hidraw or ttyUSB node and its owning group ID (see README).
# For serial use EATON_DEVICE=/dev/ttyUSB0 and its owning group below.
EATON_DEVICE=/dev/hidraw1
EATON_GID=0
# Full MQTT/radio traffic in the persistent debug log (true or false).
DEBUG=false
